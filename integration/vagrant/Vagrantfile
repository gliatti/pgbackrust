# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# Multi-VM topology that reproduces the "pgBackRest - Base de connaissance"
# (Dalibo) test matrix end to end against the Rust pgbackrest binary:
#
#   * principal  (192.168.56.11) — primary PostgreSQL cluster
#   * secondaire (192.168.56.12) — streaming standby of `principal`
#   * depot      (192.168.56.10) — dedicated backup repository server
#
# The scenarios exercised on top of this topology live in
# ../scenarios/*.sh and cover: local minimal backup, remote pull over SSH,
# backup-from-standby, tablespace remap, link-all, PITR, async/queuing,
# encryption, multiple repos, and the TLS (server / server-ping) path.
#
# Provisioning installs PostgreSQL from PGDG and drops the prebuilt Rust
# `pgbackrest` binary into /usr/bin on every node. Build the binary first
# with ../build-binary.sh (extracts target/release/pgbackrest from the
# Docker dev image into ../artifacts/pgbackrest); provisioning falls back to
# an in-VM `cargo build --release` when the artifact is absent.

NODES = {
  "depot"      => { ip: "192.168.56.10", role: "repo",    pg: false },
  "principal"  => { ip: "192.168.56.11", role: "primary", pg: true  },
  "secondaire" => { ip: "192.168.56.12", role: "standby", pg: true  },
}

PG_VERSION = ENV.fetch("PGBR_PG_VERSION", "16")

Vagrant.configure("2") do |config|
  config.vm.box = ENV.fetch("PGBR_BOX", "debian/bookworm64")
  config.ssh.insert_key = true

  # /etc/hosts for all nodes so the KB configs (pg1-host=principal,
  # repo1-host=depot, ...) resolve without DNS.
  hosts_block = NODES.map { |name, n| "#{n[:ip]} #{name}" }.join("\n")

  # The repo root is synced read-only so provisioning can grab the prebuilt
  # binary and the integration assets.
  # No repo sync (rsync is fragile on a Windows host); the prebuilt binary and a
  # throwaway shared SSH key are uploaded per node via `file` provisioners
  # instead. The default /vagrant mount is disabled to avoid Guest-Additions
  # dependencies.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  NODES.each do |name, node|
    config.vm.define name do |m|
      m.vm.hostname = name
      m.vm.network "private_network", ip: node[:ip]

      m.vm.provider "virtualbox" do |vb|
        vb.name   = "pgbr-#{name}"
        vb.memory = node[:pg] ? 1536 : 1024
        vb.cpus   = 2
      end

      m.vm.provision "hosts", type: "shell", inline: <<-SHELL
        set -e
        # idempotent /etc/hosts seed
        grep -q '# pgbr-topology' /etc/hosts || {
          echo '# pgbr-topology' >> /etc/hosts
          printf '%s\\n' "#{hosts_block}" >> /etc/hosts
        }
      SHELL

      # Upload the prebuilt Linux binary + the shared SSH keypair to /tmp; the
      # shell provisioners below install them. (Built by ../build-binary.sh and
      # ../../ ... the key is minted by run-vagrant.sh before `vagrant up`.)
      m.vm.provision "binary-file", type: "file", source: "../artifacts/pgbackrest", destination: "/tmp/pgbackrest.bin"
      m.vm.provision "sshkey-file", type: "file", source: "../artifacts/ssh/id_ed25519", destination: "/tmp/pgbr_ssh_key"
      m.vm.provision "sshpub-file", type: "file", source: "../artifacts/ssh/id_ed25519.pub", destination: "/tmp/pgbr_ssh_key.pub"

      m.vm.provision "common", type: "shell",
        path: "provision/00-common.sh",
        env: { "PGBR_ROLE" => node[:role], "PGBR_PG_VERSION" => PG_VERSION, "PGBR_INSTALL_PG" => (node[:pg] ? "1" : "0") }

      m.vm.provision "ssh", type: "shell", path: "provision/10-ssh.sh"

      if node[:pg]
        m.vm.provision "postgres", type: "shell",
          path: "provision/20-postgres.sh",
          env: { "PGBR_ROLE" => node[:role], "PGBR_PG_VERSION" => PG_VERSION }
      end

      if node[:role] == "repo"
        m.vm.provision "repo", type: "shell", path: "provision/30-repo.sh"
      end
    end
  end
end
