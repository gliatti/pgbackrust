# A single image used for all three integration nodes (principal / secondaire /
# depot). Extends the official postgres:16 (Debian bookworm) with openssh
# (for the KB pull / remote scenarios) and the prebuilt Rust pgbackrust binary.
#
# Build context is the repo root so the binary artifact can be COPYed in:
#   docker build -f integration/docker/Dockerfile.node -t pgbr-node .
ARG PG_MAJOR=16
FROM postgres:${PG_MAJOR}

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      openssh-server openssh-client ca-certificates openssl procps less \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /var/run/sshd /var/log/pgbackrust /var/spool/pgbackrust \
             /etc/pgbackrust/conf.d /etc/certs \
 && chown -R postgres:postgres /var/log/pgbackrust /var/spool/pgbackrust

# The prebuilt Linux binary produced by integration/build-binary.sh.
COPY integration/artifacts/pgbackrust /usr/bin/pgbackrust
RUN chmod 0755 /usr/bin/pgbackrust

# Node entrypoint: configures sshd + role, then sleeps (orchestration is driven
# by integration/scenarios/*.sh via `docker compose exec`).
COPY integration/docker/entrypoint.sh /usr/local/bin/pgbr-entrypoint
RUN chmod 0755 /usr/local/bin/pgbr-entrypoint

ENTRYPOINT ["/usr/local/bin/pgbr-entrypoint"]
